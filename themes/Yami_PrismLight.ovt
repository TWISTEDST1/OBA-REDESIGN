/* ------------------------------------------------------------------------- *
 * Prism Light: the light companion to Prism.
 *
 * Porcelain surfaces with white panels, the same signal-amber accent and
 * broadcast tally colours. The video preview stays dark, as in professional
 * editing tools, so colours on screen are judged correctly.
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'Prism Light';
    id: 'com.obsproject.Yami.PrismLight';
    extends: 'com.obsproject.Yami.Light';
    author: 'TWISTEDST1';
    dark: 'false';
}

@OBSThemeVars {
    /* Porcelain surfaces (semantic order matches Prism) */
    --grey1: #8A909B;
    --grey2: #B9BEC7;
    --grey3: #D5D9E0;
    --grey4: #E6E9EE;
    --grey5: #F2F4F7;
    --grey6: #FFFFFF;
    --grey7: #FFFFFF;
    --grey8: #ECEEF2;

    /* OBS palette blues remapped into the accent family */
    --blue1: #B35A0E;
    --blue2: #E2761B;
    --blue3: #E2761B;
    --blue4: #D06812;
    --blue5: #F9E1CD;
    --blue6: #FBECDF;

    /* Accent: signal amber (deepened slightly for contrast on white) */
    --primary: #E2761B;
    --primary_light: #EC8A34;
    --primary_lighter: #F29440;
    --primary_dark: #D06812;
    --primary_darker: #B35A0E;

    --text: #1B1D21;
    --text_light: #111214;
    --text_muted: #6B717C;
    --text_disabled: #A6ABB4;
    --text_inactive: #2C3036;

    --bg_window: var(--grey8);
    --bg_base: var(--grey6);
    --bg_preview: #1B1D21;

    --border_color: var(--grey3);
    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 8px;

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey7);
    --input_border: var(--grey3);
    --input_border_hover: var(--grey2);
    --input_border_focus: var(--primary);

    --list_item_bg_selected: #FBECDF;
    --list_item_bg_hover: var(--grey5);

    --button_bg: var(--grey6);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--grey3);
    --button_bg_disabled: var(--grey5);
    --button_border: var(--grey3);
    --button_border_hover: var(--grey2);
    --button_border_focus: var(--primary);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey5);
    --tab_bg_down: var(--grey4);
    --tab_border: var(--grey3);
    --tab_border_hover: var(--grey2);
    --tab_border_focus: var(--primary);
    --tab_border_selected: var(--primary);

    --scrollbar_size: 10px;
    --scrollbar_bg: var(--grey8);
    --scrollbar_handle: var(--grey3);
    --scrollbar_hover: var(--grey2);
    --scrollbar_down: var(--grey1);
    --scrollbar_border: var(--grey8);

    --separator_hover: var(--primary);
    --highlight_color: var(--primary);

    --palette_link: #B35A0E;
    --palette_linkVisited: #D06812;
}

/* ============================== Window chrome ============================= */

QMainWindow,
QDialog {
    background-color: var(--bg_window);
}

QMenuBar {
    background-color: var(--bg_window);
    border-bottom: 1px solid var(--grey5);
}

QMenuBar::item {
    border-radius: 4px;
    margin: 3px 1px;
    color: var(--text_inactive);
}

QMenuBar::item:selected {
    background: var(--grey4);
    color: var(--text_light);
}

QMenu {
    background-color: var(--grey6);
    border: 1px solid var(--grey3);
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
}

QMenu::item:selected,
QMenu::item:selected:hover {
    background: #FBECDF;
    border: 1px solid #F9E1CD;
    color: var(--text_light);
}

QMenu::separator {
    background: var(--grey4);
}

QToolTip {
    background-color: var(--grey5);
    color: var(--text);
    border: 1px solid var(--grey3);
    border-radius: 4px;
    padding: 4px 8px;
}

QMainWindow::separator:hover {
    border: none;
    background: var(--grey2);
}

/* ================================= Docks ================================== */

QDockWidget {
    color: var(--text_muted);
    font-weight: bold;
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F7F8FA);
    border: 1px solid var(--grey5);
    border-bottom: 1px solid var(--grey4);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 10px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--grey4);
}

OBSDock > QWidget {
    background: var(--grey6);
    border: 1px solid var(--grey5);
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

OBSDock QToolBar {
    border-top: 1px solid var(--grey5);
    background: transparent;
}

OBSDock QToolBar QToolButton {
    border-radius: 4px;
}

OBSDock QToolBar QToolButton:hover {
    background: var(--grey4);
    border-color: var(--grey3);
}

OBSDock QToolBar QToolButton:disabled {
    background: transparent;
}

/* ============================= Lists & trees ============================== */

QListView,
QListWidget,
QTreeView,
SourceTree,
SceneTree {
    background: transparent;
    border: none;
}

QListView::item,
QListWidget::item,
SourceTreeItem {
    border-radius: 4px;
    border: 1px solid transparent;
    margin: 1px 2px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: var(--grey5);
    border: 1px solid var(--grey5);
}

/* Selection: amber tint with a solid amber edge */
QListView::item:selected,
QListWidget::item:selected {
    background: #FBECDF;
    border: 1px solid #FBECDF;
    border-left: 3px solid #E2761B;
    color: var(--text_light);
}

QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background: #F9E1CD;
    border: 1px solid #F9E1CD;
    border-left: 3px solid #E2761B;
    color: var(--text_light);
}

QListView::item:focus,
QListWidget::item:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border-left: 3px solid #E2761B;
}

.list-grid SceneTree::item {
    border-radius: 6px;
    background: var(--grey5);
    border: 1px solid var(--grey4);
}

.list-grid SceneTree::item:hover {
    background: var(--grey4);
}

.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:checked,
.list-grid SceneTree::item:selected:hover {
    background: #FBECDF;
    border: 1px solid #E2761B;
}

QHeaderView::section {
    background-color: var(--grey5);
    color: var(--text_muted);
    border: none;
    border-right: 1px solid var(--grey4);
    padding: 4px 8px;
}

/* ================================ Buttons ================================= */

/* Tactile look: a subtle same-hue blend, lighter at the top */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F3F4F6);
    border: 1px solid #D5D9E0;
    border-radius: 6px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F7F8FA, stop:1 #ECEEF1);
    border-color: #B9BEC7;
}

QPushButton:focus {
    border-color: #E2761B;
}

QPushButton:checked,
QPushButton:checked:hover {
    background: #FBECDF;
    border-color: #E2761B;
    color: var(--text_light);
}

QPushButton:pressed,
QPushButton:pressed:hover {
    background: var(--grey7);
    border-color: var(--grey3);
}

QPushButton:disabled {
    background: var(--grey6);
    color: var(--text_disabled);
    border-color: var(--grey5);
}

QPushButton[default="true"],
.button-primary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EC8A34, stop:1 #D06812);
    border: 1px solid #B35A0E;
    color: #1A1206;
    font-weight: bold;
}

QPushButton[default="true"]:hover,
.button-primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F29440, stop:1 #E2761B);
    border-color: #D06812;
}

QToolButton,
.btn-tool {
    border-radius: 4px;
}

QToolButton:hover,
.btn-tool:hover {
    background-color: var(--grey4);
    border-color: var(--grey3);
}

QToolButton:checked,
.btn-tool:checked {
    background: #FBECDF;
    border-color: #E2761B;
}

/* ------------------------------ Controls dock ----------------------------- */

#controlsFrame QPushButton {
    min-height: 26px;
    font-weight: bold;
}

/* Primary action: Start Streaming stands out as the one amber button */
#streamButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EC8A34, stop:1 #D06812);
    border: 1px solid #B35A0E;
    color: #1A1206;
}

#streamButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F29440, stop:1 #E2761B);
    border-color: #D06812;
}

#streamButton:pressed {
    background: #B35A0E;
}

/* Tally red: live / recording */
#streamButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E5484D, stop:1 #C9373C);
    border: 1px solid #A82C31;
    color: #FFFFFF;
}

#streamButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EC5D62, stop:1 #D44348);
    border: 1px solid #C9373C;
    color: #FFFFFF;
}

/* Teal: virtual camera, replay buffer, studio mode */
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14B8A6, stop:1 #0E9486);
    border: 1px solid #0B7A6F;
    color: #FFFFFF;
}

#replayBufferButton:hover:!pressed.state-active,
#virtualCamButton:hover:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #22C7B5, stop:1 #12A594);
    border: 1px solid #0B7A6F;
    color: #FFFFFF;
}

/* ================================= Inputs ================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    border-radius: 5px;
    selection-background-color: #E2761B;
    selection-color: #1A1206;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #E2761B;
    background-color: var(--grey7);
}

QComboBox QAbstractItemView {
    background-color: var(--grey6);
    border: 1px solid var(--grey3);
    border-radius: 6px;
    selection-background-color: #FBECDF;
}

/* ================================ Sliders ================================= */

QSlider::groove {
    background-color: var(--grey4);
    border-radius: 2px;
}

QSlider::groove:horizontal {
    height: 4px;
}

QSlider::groove:vertical {
    width: 4px;
}

QSlider::sub-page:horizontal {
    background: #E2761B;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background: #E2761B;
    border-radius: 2px;
}

QSlider::handle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #E6E9EE);
    border: 1px solid #B9BEC7;
    border-radius: 6px;
}

QSlider::handle:hover,
QSlider::handle:pressed {
    background: #FFFFFF;
    border-color: #E2761B;
}

/* ============================== Audio meters ============================== */

VolumeMeter {
    qproperty-backgroundNominalColor: #D3F2E2;
    qproperty-backgroundWarningColor: #F8EDC8;
    qproperty-backgroundErrorColor: #FAD7D8;
    qproperty-foregroundNominalColor: #1FB871;
    qproperty-foregroundWarningColor: #E0A91B;
    qproperty-foregroundErrorColor: #E5484D;
    qproperty-magnitudeColor: #1B1D21;
    qproperty-majorTickColor: #5A5F68;
    qproperty-minorTickColor: #C3C8D0;
}

VolumeControl .mixer-category {
    background: var(--grey5);
    color: var(--text_muted);
    border-radius: 4px;
}

VolumeControl.volume-pinned .mixer-category {
    background: var(--grey4);
    color: var(--text_inactive);
}

/* ================================== Tabs ================================== */

QTabBar::tab {
    background-color: transparent;
    color: var(--text_muted);
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin: 0px 2px;
}

QTabBar::tab:hover {
    color: var(--text);
    border-bottom: 2px solid var(--grey2);
}

QTabBar::tab:selected {
    background-color: transparent;
    color: var(--text_light);
    border-bottom: 2px solid #E2761B;
}

QTabWidget::pane {
    border: 1px solid var(--grey4);
    border-radius: 8px;
}

/* =============================== Scrollbars =============================== */

QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar::handle {
    background-color: var(--grey3);
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background-color: var(--grey2);
}

QScrollBar::handle:pressed {
    background-color: var(--grey1);
}

/* ============================ Misc / status bar =========================== */

OBSQTDisplay {
    qproperty-displayBackgroundColor: #1B1D21;
}

OBSBasicStatusBar {
    background: var(--bg_window);
    border-top: 1px solid var(--grey5);
    color: var(--text_muted);
}

QProgressBar {
    background: var(--grey5);
    border: none;
    border-radius: 3px;
}

QProgressBar::chunk {
    background: #E2761B;
    border: none;
    border-radius: 3px;
}

QGroupBox {
    background: var(--grey6);
    border: 1px solid var(--grey5);
    border-radius: 8px;
}

#contextContainer {
    background: var(--grey6);
    border-top: 1px solid var(--grey5);
}

idian--ToggleSwitch {
    qproperty-background: var(--grey4);
    qproperty-background_hover: var(--grey3);
    qproperty-background_checked: #E2761B;
    qproperty-background_checked_hover: #EC8A34;
}

SourceSelectButton QPushButton:checked {
    background: #FBECDF;
    border-color: #E2761B;
}

QCalendarWidget QToolButton:hover {
    background-color: var(--grey4);
}
